{
  "schemaVersion": 1,
  "id": "craft-autocomplete",
  "version": "${version}",
  "name": "Craft Autocomplete",
  "description": "Подсказывает следующий крафт в верстаке, инвентаре и печах и ставит его по Tab.",
  "authors": ["ijustseen"],
  "license": "MIT",
  "icon": "assets/craft-autocomplete/icon.png",
  "environment": "client",
  "custom": {
    "modmenu": {
      "badges": ["client"]
    }
  },
  "accessWidener": "craft-autocomplete.accesswidener",
  "entrypoints": {
    "client": ["dev.ijustseen.craftautocomplete.FabricEntrypoint"]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_min}",
    "minecraft": "${minecraft}",
    "java": ">=${java_min}",
    "fabric-api": "*"
  }
}
